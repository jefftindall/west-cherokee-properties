---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StreetView from '../../components/StreetView.astro';
import NeighborhoodLabel from '../../components/NeighborhoodLabel.astro';
import PropertyLinks from '../../components/PropertyLinks.astro';
import { getCollection, render } from 'astro:content';
import { formatFloorPlan } from '../../lib/units';
import { neighborhoodPath } from '../../lib/neighborhoods';
import { propertyHasVacancy, unitIsAvailable } from '../../lib/properties';

export async function getStaticPaths() {
  const properties = await getCollection('properties');
  return properties.map((property) => ({
    params: { slug: property.id },
    props: { property },
  }));
}

const { property } = Astro.props;
const { Content } = await render(property);
const vacant = propertyHasVacancy(property);
---

<BaseLayout
  title={property.data.title}
  description={property.data.summary}
  canonicalPath={`/properties/${property.id}`}
>
  <article class="mx-auto max-w-3xl px-4 py-16">
    <p class="text-sm uppercase tracking-wide text-grove">
      <NeighborhoodLabel
        label={property.data.neighborhood || `${property.data.city}, ${property.data.state}`}
        slug={property.data.neighborhoodSlug}
      />
    </p>
    <h1 class="font-display mt-2 text-5xl text-pine">{property.data.title}</h1>
    <p class="mt-3 text-lg text-muted">{property.data.address}</p>
    <p class:list={['mt-2 text-sm font-semibold', vacant ? 'text-leaf' : 'text-muted']}>
      {vacant ? 'Accepting applications' : 'Currently leased — we are not taking applications for this address'}
    </p>

    <div class="mt-8">
      <StreetView
        title={property.data.title}
        address={property.data.address}
        lat={property.data.lat}
        lng={property.data.lng}
        heading={property.data.heading}
        tilt={property.data.tilt}
        panoId={property.data.panoId}
      />
    </div>
    <PropertyLinks address={property.data.address} zillowUrl={property.data.zillowUrl} />
    {
      property.data.neighborhoodSlug && (
        <p class="mt-3 text-sm">
          <a class="text-grove underline-offset-2 hover:underline" href={neighborhoodPath(property.data.neighborhoodSlug)}>
            Things to do nearby
          </a>
        </p>
      )
    }

    <h2 class="mt-10 text-sm font-semibold uppercase tracking-wide text-grove">Units</h2>
    <ul class="mt-3 space-y-1 text-lg text-ink">
      {
        property.data.units.map((unit) => (
          <li>
            {formatFloorPlan(unit)}
            <span class="text-muted"> — {unitIsAvailable(unit) ? 'available' : 'leased'}</span>
          </li>
        ))
      }
    </ul>
    {
      property.data.highlights.length > 0 && (
        <ul class="mt-6 list-disc space-y-1 pl-5 text-ink">
          {property.data.highlights.map((item) => <li>{item}</li>)}
        </ul>
      )
    }
    <div class="prose-site mt-8 text-ink">
      <Content />
    </div>
    {
      vacant ? (
        <a class="btn-primary mt-10" href={`/apply?property=${property.id}`}>
          Apply to rent here
        </a>
      ) : (
        <p class="mt-10 rounded-xl border border-line bg-panel p-5 text-muted">
          This address is full. <a class="text-grove underline-offset-2 hover:underline" href="/contact">Tell us which home you like</a> and we will keep you in mind — a formal waitlist is coming.
        </p>
      )
    }
  </article>
</BaseLayout>
