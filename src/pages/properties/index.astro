---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import { getCollection } from 'astro:content';

const properties = (await getCollection('properties')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Properties" description="Three rental addresses in Cartersville — downtown on West Cherokee and Noble, plus Falcon Circle north of town.">
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h1 class="font-display text-5xl text-pine">Our homes</h1>
    <p class="mt-4 max-w-2xl text-muted">
      Two places sit in <a class="text-grove underline-offset-2 hover:underline" href="/neighborhoods/historic-downtown">historic downtown</a>, a short walk from the square. Falcon Circle is a quieter street in <a class="text-grove underline-offset-2 hover:underline" href="/neighborhoods/north-cartersville">North Cartersville</a>. Nothing is for rent today — peek at the street and the map, then write us if you want to hear when a unit opens.
    </p>
    <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        properties.map((property) => (
          <li>
            <PropertyCard property={property} />
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
