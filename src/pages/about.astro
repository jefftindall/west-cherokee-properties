---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing about page content');
const { Content } = await render(page);
---

<BaseLayout title="About" description={page.data.description}>
  <article class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="font-display text-5xl text-pine">About</h1>
    <div class="prose-site mt-8 space-y-4 text-lg text-ink">
      <Content />
    </div>
  </article>
</BaseLayout>
