---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OfficeNav from '../../components/OfficeNav.astro';
---

<BaseLayout title="Office" description="Staff workspace" noIndex hideNav hideFooter>
  <OfficeNav />
  <section class="mx-auto max-w-6xl px-4 py-10">
    <h1 class="font-display text-4xl text-pine">Office</h1>
    <p class="mt-3 text-muted">Applications, leases, invoices, and service requests for every property.</p>
    <ul class="mt-8 grid gap-4 md:grid-cols-2">
      <li><a class="block rounded-lg border border-line bg-panel p-5 no-underline" href="/office/applications">Applications</a></li>
      <li><a class="block rounded-lg border border-line bg-panel p-5 no-underline" href="/office/renters">Renters</a></li>
      <li><a class="block rounded-lg border border-line bg-panel p-5 no-underline" href="/office/leases">Leases</a></li>
      <li><a class="block rounded-lg border border-line bg-panel p-5 no-underline" href="/office/invoices">Invoices</a></li>
      <li><a class="block rounded-lg border border-line bg-panel p-5 no-underline" href="/office/requests">Service requests</a></li>
      <li><a class="block rounded-lg border border-line bg-panel p-5 no-underline" href="/office/access">Access</a></li>
    </ul>
    <p id="office-health" class="mt-8 text-sm text-muted" data-testid="office-health">Checking session…</p>
  </section>
  <script>
    const el = document.getElementById('office-health');
    fetch('/api/office/health')
      .then(async (res) => {
        const json = await res.json().catch(() => ({}));
        if (!el) return;
        if (res.ok) {
          el.id = 'office-health-ok';
          el.textContent = `Signed in${json.email ? ` as ${json.email}` : ''}.`;
        } else {
          el.textContent = json.error || 'Not authorized for office tools.';
        }
      })
      .catch(() => {
        if (el) el.textContent = 'Office API is not reachable locally unless Functions are running.';
      });
  </script>
</BaseLayout>
