---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OfficeNav from '../../components/OfficeNav.astro';
---

<BaseLayout title="Invoices" description="Rent invoices" noIndex hideNav hideFooter>
  <OfficeNav />
  <section class="mx-auto max-w-6xl px-4 py-10">
    <div id="office-back-link"></div>
    <h1 class="font-display text-4xl text-pine">Invoices</h1>
    <form id="inv-form" class="mt-6 flex flex-wrap items-end gap-3">
      <input name="leaseId" placeholder="Lease ID" required />
      <input name="periodStart" type="date" required />
      <input name="periodEnd" type="date" required />
      <label class="flex items-center gap-2 text-sm text-muted">
        <input id="inv-notify" name="notify" type="checkbox" value="true" />
        Email balance statement after create
      </label>
      <button id="inv-submit" class="btn-primary" type="submit">Generate this period</button>
    </form>
    <p class="mt-2 max-w-2xl text-xs text-muted">
      Email is off by default. Checking the box sends a one-off balance notice after the invoice is
      created — it does not require automatic-communications consent.
    </p>

    <div class="mt-10 border-t border-line pt-8">
      <h2 class="font-display text-2xl text-pine">Catch up missing months</h2>
      <p class="mt-2 max-w-2xl text-sm text-muted">
        Creates open invoices for every billing month that is missing through today. Catch-up charges
        never get an automatic late fee. Email is optional and off by default. Dry-run first, then confirm.
      </p>
      <form id="catchup-form" class="mt-4 flex flex-wrap items-end gap-3">
        <div>
          <label for="catchup-lease" class="block text-sm text-muted">Lease ID (optional)</label>
          <input id="catchup-lease" name="leaseId" placeholder="All active leases" class="mt-1" />
        </div>
        <label class="flex items-center gap-2 text-sm text-muted">
          <input id="catchup-notify" name="notify" type="checkbox" value="true" />
          Email balance statement after create
        </label>
        <button id="catchup-dry" class="btn-secondary" type="submit" data-dry-run="true">Dry-run</button>
        <button id="catchup-run" class="btn-primary" type="submit" data-dry-run="false">Create</button>
      </form>
      <div id="catchup-errors" class="mt-2"></div>
      <p id="catchup-status" class="mt-2 text-sm text-muted" role="status"></p>
      <pre id="catchup-result" class="mt-3 max-h-80 overflow-auto rounded border border-line bg-panel p-3 text-xs text-ink empty:hidden"></pre>
    </div>

    <div id="inv-errors" class="mt-2"></div>
    <p id="inv-status" class="mt-2 text-sm text-muted" role="status"></p>
    <div id="list" class="mt-6 text-sm"></div>
  </section>
  <script>
    import { apiFetch, isApiFetchExhausted } from '../../lib/apiFetch.ts';
    import {
      bindApiFetchStatus,
      clearErrorBanner,
      clearLoading,
      renderLoading,
      setButtonBusy,
      showApiExhaustedBanner,
      showErrorBanner,
    } from '../../lib/uiFeedback.ts';
    import { formatMoney } from '../../lib/money.ts';
    import { mountOfficeBackLink } from '../../lib/officeNav.ts';

    const root = document.getElementById('list');
    const status = document.getElementById('inv-status');
    const errors = document.getElementById('inv-errors');
    const submit = document.getElementById('inv-submit') as HTMLButtonElement | null;
    const catchupErrors = document.getElementById('catchup-errors');
    const catchupStatus = document.getElementById('catchup-status');
    const catchupResult = document.getElementById('catchup-result');
    const catchupDry = document.getElementById('catchup-dry') as HTMLButtonElement | null;
    const catchupRun = document.getElementById('catchup-run') as HTMLButtonElement | null;

    async function load() {
      renderLoading(root, 'Loading invoices…', { block: true });
      try {
        const res = await apiFetch('/api/office/invoices', {
          onStatus: bindApiFetchStatus({ loadingHost: root }),
        });
        const json = await res.json().catch(() => ({}));
        clearLoading(root);
        if (!root) return;
        if (!res.ok) {
          showErrorBanner(errors, json.error || 'Could not load invoices.');
          return;
        }
        const rows = json.invoices || [];
        root.innerHTML = rows.length
          ? `<ul class="space-y-2">${rows
              .map(
                (row: {
                  invoice: { status: string; amountCents: number; periodStart: string; billingSource?: string };
                  person?: { displayName?: string } | null;
                  unit?: { label?: string } | null;
                  property?: { title?: string } | null;
                }) => {
                  const property = row.property?.title || 'Property';
                  const unit = row.unit?.label ? ` · Unit ${row.unit.label}` : '';
                  const renter = row.person?.displayName || 'Tenant';
                  const due = row.invoice.periodStart;
                  const amount = formatMoney(row.invoice.amountCents);
                  const source = row.invoice.billingSource ? ` · ${row.invoice.billingSource}` : '';
                  return `<li class="rounded border border-line bg-panel p-3">${property}${unit} · ${renter} · ${due} · ${row.invoice.status} · ${amount}${source}</li>`;
                },
              )
              .join('')}</ul>`
          : 'No invoices yet.';
      } catch (err) {
        clearLoading(root);
        if (isApiFetchExhausted(err)) showApiExhaustedBanner(errors, err);
        else showErrorBanner(errors, 'Office API is not reachable locally unless Functions are running.');
      }
    }

    document.getElementById('inv-form')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const form = event.target as HTMLFormElement;
      const data = new FormData(form);
      clearErrorBanner(errors);
      setButtonBusy(submit, true, 'Creating…');
      try {
        const res = await apiFetch('/api/office/invoices', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            leaseId: data.get('leaseId'),
            periodStart: data.get('periodStart'),
            periodEnd: data.get('periodEnd'),
            notify: data.get('notify') === 'true',
          }),
          onStatus: bindApiFetchStatus({ button: submit, statusEl: status }),
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok) {
          showErrorBanner(errors, json.error || 'Could not create invoice.');
          return;
        }
        if (status) {
          const emailed = json.email && !json.email.skipped;
          status.textContent = emailed
            ? 'Invoice created and balance notice emailed.'
            : 'Invoice created.';
        }
        load();
      } catch (err) {
        if (isApiFetchExhausted(err)) showApiExhaustedBanner(errors, err);
        else showErrorBanner(errors, 'Could not create invoice. Try again.');
      } finally {
        setButtonBusy(submit, false);
      }
    });

    document.getElementById('catchup-form')?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submitter = (event as SubmitEvent).submitter as HTMLButtonElement | null;
      const dryRun = submitter?.dataset.dryRun !== 'false';
      const form = event.target as HTMLFormElement;
      const formData = new FormData(form);
      const leaseId = String(formData.get('leaseId') || '').trim();
      const notify = formData.get('notify') === 'true';
      const busyBtn = dryRun ? catchupDry : catchupRun;
      clearErrorBanner(catchupErrors);
      if (catchupResult) catchupResult.textContent = '';
      setButtonBusy(busyBtn, true, dryRun ? 'Checking…' : 'Creating…');
      setButtonBusy(dryRun ? catchupRun : catchupDry, true);
      try {
        const res = await apiFetch('/api/office/invoices/catch-up', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            dryRun,
            notify,
            ...(leaseId ? { leaseId } : {}),
          }),
          onStatus: bindApiFetchStatus({ button: busyBtn, statusEl: catchupStatus }),
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok) {
          showErrorBanner(catchupErrors, json.error || 'Catch-up failed.');
          return;
        }
        const would = (json.leases || []).reduce(
          (sum: number, row: { wouldCreateCount?: number }) => sum + (row.wouldCreateCount || 0),
          0,
        );
        if (catchupStatus) {
          if (dryRun) {
            catchupStatus.textContent = notify
              ? `Dry-run: ${would} invoice(s) would be created across ${json.leaseCount || 0} lease(s); email would be sent when notify is on.`
              : `Dry-run: ${would} invoice(s) would be created across ${json.leaseCount || 0} lease(s) (no email).`;
          } else {
            catchupStatus.textContent = notify
              ? `Created ${json.created || 0} invoice(s); emailed ${json.emailed || 0} lease(s).`
              : `Created ${json.created || 0} invoice(s) (no email).`;
          }
        }
        if (catchupResult) catchupResult.textContent = JSON.stringify(json, null, 2);
        if (!dryRun) load();
      } catch (err) {
        if (isApiFetchExhausted(err)) showApiExhaustedBanner(catchupErrors, err);
        else showErrorBanner(catchupErrors, 'Catch-up failed. Try again.');
      } finally {
        setButtonBusy(catchupDry, false);
        setButtonBusy(catchupRun, false);
      }
    });

    mountOfficeBackLink({ host: document.getElementById('office-back-link'), whenReturnOnly: true, fallbackHref: '/office' });
    load();
  </script>
</BaseLayout>
