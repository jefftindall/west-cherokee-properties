---
import BaseLayout from '../layouts/BaseLayout.astro';
import PropertyCard from '../components/PropertyCard.astro';
import { getCollection } from 'astro:content';
import { neighborhoodPath } from '../lib/neighborhoods';
import { siteHasVacancy } from '../lib/properties';

const properties = (await getCollection('properties')).sort((a, b) => a.data.order - b.data.order);
const neighborhoods = (await getCollection('neighborhoods')).sort((a, b) => a.data.order - b.data.order);
const accepting = siteHasVacancy(properties);
---

<BaseLayout>
  <section class="mx-auto max-w-6xl px-4 pb-16 pt-14 md:pb-20 md:pt-20">
    <p class="text-sm font-semibold uppercase tracking-[0.25em] text-clay">Cartersville, Georgia</p>
    <h1 class="font-display mt-3 max-w-3xl text-5xl leading-[0.95] text-pine md:text-7xl">
      Your next home
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-muted">
      We manage three addresses: the house at 124 W Cherokee, the cottage next door on Noble, and two units on Falcon Circle. Downtown is walkable and lively; Falcon Circle is quieter, across from the College and Career Academy. Every home is leased right now. When one opens, we will take applications here.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn-primary" href="/properties">See our homes</a>
      {
        accepting ? (
          <a class="btn-secondary" href="/apply">
            Start an application
          </a>
        ) : (
          <a class="btn-secondary" href="/contact">
            Say hello
          </a>
        )
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-8" aria-labelledby="neighborhoods-heading">
    <h2 id="neighborhoods-heading" class="font-display text-3xl text-pine">Two parts of town</h2>
    <p class="mt-3 max-w-2xl text-muted">
      Both neighborhoods sit a short drive from I-75. See what is actually nearby — coffee and the square downtown, errands and the Savoy on the north side.
    </p>
    <ul class="mt-8 grid gap-6 md:grid-cols-2">
      {
        neighborhoods.map((neighborhood) => (
          <li class="rounded-xl border border-line bg-panel p-6">
            <h3 class="font-display text-2xl text-pine">
              <a class="text-pine no-underline hover:underline" href={neighborhoodPath(neighborhood.id)}>
                {neighborhood.data.title}
              </a>
            </h3>
            <p class="mt-2 text-muted">{neighborhood.data.teaser}</p>
            <a class="btn-ghost mt-4" href={neighborhoodPath(neighborhood.id)}>
              Things to do nearby
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto grid max-w-6xl gap-6 px-4 py-16 md:grid-cols-2 lg:grid-cols-3" aria-labelledby="properties-heading">
    <h2 id="properties-heading" class="sr-only">Properties</h2>
    {properties.map((property) => <PropertyCard property={property} />)}
  </section>
</BaseLayout>
