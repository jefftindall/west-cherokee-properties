---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { propertyHasVacancy, siteHasVacancy } from '../lib/properties';

const properties = (await getCollection('properties')).sort((a, b) => a.data.order - b.data.order);
const openProperties = properties.filter(propertyHasVacancy);
const accepting = siteHasVacancy(properties);
const requested = Astro.url.searchParams.get('property') || '';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';
---

<BaseLayout
  title="Apply"
  description={
    accepting
      ? 'Apply for an open West Cherokee Properties home. We use one form for every household.'
      : 'None of our Cartersville homes are for rent right now. Write us if you want to hear when one opens.'
  }
>
  <section class="mx-auto max-w-xl px-4 py-16">
    <h1 class="font-display text-5xl text-pine">{accepting ? 'Apply' : 'Nothing for rent right now'}</h1>
    {
      accepting ? (
        <p class="mt-4 text-muted">
          Same form for every household. We do not collect Social Security numbers or protected-class information.
        </p>
      ) : (
        <div class="mt-4 space-y-4 text-muted">
          <p>Every unit at 124 W Cherokee, 11 Noble, and 10 Falcon Circle is leased. We only take applications when a home is actually open.</p>
          <p>
            If you have a favorite address, <a class="text-grove underline-offset-2 hover:underline" href="/contact">send a note</a> and we will remember you. A waitlist you can join per property is on the way.
          </p>
          <a class="btn-primary mt-2" href="/properties">See the homes anyway</a>
        </div>
      )
    }
    {
      accepting && (
        <form id="apply-form" class="mt-8 space-y-4">
          <div>
            <label for="propertySlug">Property</label>
            <select id="propertySlug" name="propertySlug" required>
              {openProperties.map((property) => (
                <option value={property.id} selected={property.id === requested}>
                  {property.data.title}
                </option>
              ))}
            </select>
          </div>
          <div>
            <label for="fullName">Full legal name</label>
            <input id="fullName" name="fullName" required maxlength="200" autocomplete="name" />
          </div>
          <div>
            <label for="email">Email</label>
            <input id="email" name="email" type="email" required maxlength="320" autocomplete="email" />
          </div>
          <div>
            <label for="phone">Phone</label>
            <input id="phone" name="phone" required maxlength="40" autocomplete="tel" />
          </div>
          <div>
            <label for="desiredMoveIn">Desired move-in date</label>
            <input id="desiredMoveIn" name="desiredMoveIn" type="date" required />
          </div>
          <div>
            <label for="householdSize">Household size</label>
            <input id="householdSize" name="householdSize" type="number" min="1" max="12" value="1" required />
          </div>
          <div>
            <label for="notes">Anything we should know (optional)</label>
            <textarea id="notes" name="notes" rows="4" maxlength="4000"></textarea>
          </div>
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
          <div id="apply-errors"></div>
          <button id="apply-submit" class="btn-primary" type="submit">Submit application</button>
          <p id="apply-status" class="text-sm text-muted" role="status"></p>
        </form>
      )
    }
  </section>
  {accepting ? <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer /> : null}
  {accepting ? (
    <script>
      import { clearErrorBanner, setButtonBusy, showErrorBanner } from '../lib/uiFeedback.ts';

      const form = document.getElementById('apply-form') as HTMLFormElement | null;
      const status = document.getElementById('apply-status');
      const errors = document.getElementById('apply-errors');
      const submit = document.getElementById('apply-submit') as HTMLButtonElement | null;
      const select = document.getElementById('propertySlug') as HTMLSelectElement | null;
      const requested = new URLSearchParams(location.search).get('property');
      if (select && requested) {
        const option = [...select.options].find((item) => item.value === requested);
        if (option) select.value = requested;
      }
      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!status) return;
        clearErrorBanner(errors);
        setButtonBusy(submit, true, 'Submitting…');
        const data = new FormData(form);
        const tokenInput = form.querySelector<HTMLInputElement>('[name="cf-turnstile-response"]');
        const payload = {
          propertySlug: String(data.get('propertySlug') || ''),
          fullName: String(data.get('fullName') || ''),
          email: String(data.get('email') || ''),
          phone: String(data.get('phone') || ''),
          desiredMoveIn: String(data.get('desiredMoveIn') || ''),
          householdSize: Number(data.get('householdSize') || 1),
          notes: String(data.get('notes') || ''),
          turnstileToken: tokenInput?.value || '',
        };
        try {
          const res = await fetch('/api/apply', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const json = await res.json().catch(() => ({}));
          if (!res.ok) {
            showErrorBanner(errors, json.error || 'Could not submit. Try again.');
            return;
          }
          status.textContent = 'Application received. We will email you next steps.';
          form.reset();
        } catch {
          showErrorBanner(errors, 'Could not submit. Try again.');
        } finally {
          setButtonBusy(submit, false);
        }
      });
    </script>
  ) : null}
</BaseLayout>
