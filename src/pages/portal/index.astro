---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortalNav from '../../components/PortalNav.astro';
---

<BaseLayout title="Resident portal" description="Your lease, rent, and requests" noIndex hideNav hideFooter>
  <PortalNav />
  <section class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="font-display text-4xl text-pine">Resident portal</h1>
    <div id="portal-errors" class="mt-4"></div>
    <p id="portal-status" class="mt-4 text-muted"></p>
    <div class="mt-8 grid gap-4">
      <a class="rounded-lg border border-line bg-panel p-5 no-underline" href="/portal/lease">Lease</a>
      <a class="rounded-lg border border-line bg-panel p-5 no-underline" href="/portal/invoices">Invoices and receipts</a>
      <a class="rounded-lg border border-line bg-panel p-5 no-underline" href="/portal/requests">Service requests</a>
    </div>
  </section>
  <script>
    import { apiFetch, isApiFetchExhausted } from '../../lib/apiFetch.ts';
    import {
      bindApiFetchStatus,
      clearLoading,
      renderLoading,
      showApiExhaustedBanner,
      showErrorBanner,
    } from '../../lib/uiFeedback.ts';

    const el = document.getElementById('portal-status');
    const errors = document.getElementById('portal-errors');

    async function load() {
      renderLoading(el, 'Loading your household…');
      try {
        const res = await apiFetch('/api/portal/me', {
          onStatus: bindApiFetchStatus({ loadingHost: el }),
        });
        const json = await res.json().catch(() => ({}));
        clearLoading(el);
        if (!el) return;
        if (res.ok && json.person) {
          el.textContent = `Signed in as ${json.person.email}.`;
        } else if (res.ok) {
          el.innerHTML =
            'No lease is on file for this sign-in yet. If you already live with us, write <a href="/contact">the office</a> so we can link your account.';
        } else {
          showErrorBanner(errors, json.error || 'Could not load portal.');
        }
      } catch (err) {
        clearLoading(el);
        if (isApiFetchExhausted(err)) showApiExhaustedBanner(errors, err);
        else showErrorBanner(errors, 'Portal API is not reachable locally unless Functions are running.');
      }
    }

    load();
  </script>
</BaseLayout>
