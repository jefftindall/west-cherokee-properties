---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortalNav from '../../components/PortalNav.astro';
---

<BaseLayout title="Your lease" description="Lease details" noIndex hideNav hideFooter>
  <PortalNav />
  <section class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="font-display text-4xl text-pine">Lease</h1>
    <pre id="lease" class="mt-6 overflow-x-auto rounded bg-panel p-4 text-sm"></pre>
  </section>
  <script>
    const el = document.getElementById('lease');
    fetch('/api/portal/lease')
      .then(async (res) => {
        const json = await res.json().catch(() => ({}));
        if (!el) return;
        el.textContent = res.ok ? JSON.stringify(json.lease || json, null, 2) : json.error || 'Could not load lease.';
      })
      .catch(() => {
        if (el) el.textContent = 'Portal API is not reachable.';
      });
  </script>
</BaseLayout>
