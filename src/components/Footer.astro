---
import { site } from '../lib/site';
import Logo from './Logo.astro';
---

<footer class="mt-16 border-t border-line bg-panel">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 md:grid-cols-3">
    <div>
      <Logo size="sm" />
      <p class="mt-3 text-sm text-muted">{site.tagline}</p>
      <p class="mt-3 text-sm">
        <a class="text-grove underline-offset-2 hover:underline" href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <p class="mt-1 text-sm">
        <a class="text-grove underline-offset-2 hover:underline" href={`tel:${site.phoneTel}`}>
          {site.phoneLabel}
        </a>
      </p>
    </div>
    <div class="text-sm">
      <p class="font-semibold uppercase tracking-wide text-muted">Visit</p>
      <ul class="mt-2 space-y-1">
        <li><a class="text-grove underline-offset-2 hover:underline" href="/properties">Properties</a></li>
        <li><a class="text-grove underline-offset-2 hover:underline" href="/neighborhoods">Neighborhoods</a></li>
        <li><a class="text-grove underline-offset-2 hover:underline" href="/apply">Apply</a></li>
        <li><a class="text-grove underline-offset-2 hover:underline" href="/contact">Contact</a></li>
      </ul>
    </div>
    <div class="text-sm">
      <p class="font-semibold uppercase tracking-wide text-muted">Accounts</p>
      <ul class="mt-2 space-y-1">
        <li><a class="text-grove underline-offset-2 hover:underline" href="/portal">Resident portal</a></li>
        <li><a class="text-grove underline-offset-2 hover:underline" href="/office">Office</a></li>
      </ul>
    </div>
  </div>
  <p class="border-t border-line px-4 py-4 text-center text-xs text-muted">
    Equal Housing Opportunity. Cartersville, Georgia.
  </p>
</footer>
