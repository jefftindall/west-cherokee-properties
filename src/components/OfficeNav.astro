---
import Logo from './Logo.astro';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/office';
const links = [
  { href: '/office', label: 'Dashboard' },
  { href: '/office/applications', label: 'Applications' },
  { href: '/office/renters', label: 'Renters' },
  { href: '/office/leases', label: 'Leases' },
  { href: '/office/invoices', label: 'Invoices' },
  { href: '/office/payments', label: 'Payments' },
  { href: '/office/requests', label: 'Requests' },
  { href: '/office/access', label: 'Access' },
];
---

<header class="border-b border-line bg-panel">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-4 py-3">
    <div class="flex items-center gap-3">
      <Logo href="/office" mark size="sm" />
      <a href="/office" class="text-lg font-semibold text-pine no-underline">Office</a>
    </div>
    <nav class="flex flex-wrap gap-4 text-sm font-semibold text-grove">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'no-underline hover:underline',
              path === link.href ? 'text-clay' : null,
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a class="no-underline hover:underline" href="/.auth/logout">Sign out</a>
    </nav>
  </div>
</header>
