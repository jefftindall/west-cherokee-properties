---
interface Props {
  href?: string;
  size?: 'sm' | 'md' | 'lg';
  mark?: boolean;
}

const { href = '/', size = 'md', mark = false } = Astro.props;
const heightClass = {
  sm: 'h-8',
  md: 'h-10 md:h-12',
  lg: 'h-14 md:h-16',
}[size];
---

<a href={href} class:list={['inline-flex shrink-0 items-center no-underline', heightClass]}>
  <img
    src={mark ? '/mark.png' : '/logo.png'}
    alt="West Cherokee Properties"
    width={mark ? 256 : 627}
    height={mark ? 256 : 210}
    class="h-full w-auto"
  />
</a>
